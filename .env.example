# =============================================================================
# CTI Platform - environment template
# Copy to .env  ->  cp .env.example .env   then adjust values.
# Every value below has a sane default in app/config.py; anything unset
# simply falls back to free/open defaults (zero-dollar operation).
# =============================================================================

# --- ClickHouse --------------------------------------------------------------
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cti
CLICKHOUSE_SECURE=false

# --- AI Engine (LLM) ---------------------------------------------------------
# Zero-dollar policy: the engine auto-resolves providers in this order:
#   Groq (free key) -> Gemini (free key) -> Ollama (local).
# You only need ONE of the first two; Ollama is the last-resort fallback.
# Force a provider with LLM_PROVIDER=groq|gemini|ollama (default: auto).
LLM_PROVIDER=auto

# Option A - Groq (free key): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B - Google Gemini (free key via Google AI Studio):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Local Ollama fallback (used automatically when no cloud key is set).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- AI fiche pipeline reliability (Phase 4, all optional) -------------------
# Global min spacing between LLM calls (free-tier throttling; Gemini ~20 RPM).
AI_MIN_INTERVAL_SECONDS=3.0
# Persistent attempt cap per CVE before it stays failed (across restarts).
AI_MAX_ATTEMPTS=3
# Cooldown before a failed CVE is auto-retried by the scheduler (minutes).
AI_RETRY_COOLDOWN_MINUTES=60
# Crash recovery: requeue rows stuck in pending/processing after this age.
AI_STALE_PROCESSING_MINUTES=5
# In-flight fiche job queue capacity (work is never dropped when full).
AI_QUEUE_SIZE=500

# --- Tor / Dark Web scraping --------------------------------------------------
# Standard Tor SOCKS5 exit node. Defaults target the standard Tor install.
TOR_PROXY=socks5h://127.0.0.1:9050
DARKWEB_ENABLED=false

# --- Telegram (DEFERRED to a future phase) ------------------------------------
# Outbound alert push is NOT enabled yet (ALERT_TELEGRAM defaults to false).
# When you want it, set a bot token from @BotFather + the channel (bot must be
# an admin of the channel). The Telegram *ingestion* hook below reuses the same
# token and is independent of alerting.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=

# --- Real-time alerting (Phase 5, all optional) -------------------------------
# Master switch + thresholds. Alerts land in the in-app bell.
ALERTING_ENABLED=true
ALERT_MIN_RISK=HIGH
# Always alert on CISA KEV / advisory CVEs regardless of modelled risk.
ALERT_KEV_ALWAYS=true
# Future: enable the Telegram push (requires TELEGRAM_BOT_TOKEN + CHANNEL).
ALERT_TELEGRAM=false
NOTIFICATIONS_PAGE_SIZE=50


# --- Free / optional API keys -------------------------------------------------
# NVD free API key (https://nvd.nist.gov/developers/request-an-api-key)
# Without it the engine falls back to the unauthenticated quota (5 req/30s).
NVD_API_KEY=

# AlienVault OTX free key (https://otx.alienvault.com/api) - optional.
OTX_API_KEY=

# MISP instance (free self-hosted). Leave empty to disable.
MISP_URL=
MISP_API_KEY=

# --- API server ---------------------------------------------------------------
# Allowed browser origins for the future React (Vite) frontend (JSON array).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Bearer token required on state-changing endpoints (POST /api/v1/ingest).
API_ACCESS_TOKEN=change-me-in-production

# --- Scheduler ----------------------------------------------------------------
# Poll interval in seconds per collector family.
POLL_INTERVAL_RSS=600
POLL_INTERVAL_JSON=1800
POLL_INTERVAL_NVD=3600
