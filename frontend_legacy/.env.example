# API base URL. Leave empty to use the same origin as the page (recommended:
# dev uses the Vite proxy, prod is served by FastAPI itself).
VITE_API_BASE=

# Access token for state-changing endpoints (POST /api/v1/process,
# POST /api/v1/ingest). Must match API_ACCESS_TOKEN in the backend .env.
VITE_API_TOKEN=
